# Port the API server listens on. Most hosting platforms (Render, Railway,
# Heroku, etc.) set this automatically — you do not need to set it yourself
# in production. Defaults to 4000 if unset.
# PORT=4000

# Origin of the deployed frontend, added to the CORS allow-list alongside the
# local dev origins (localhost:5173/5174). Required in production so the
# deployed frontend can call this API; not needed for local development.
# FRONTEND_URL=https://your-frontend.onrender.com

# Explicit local-dev override for the API port. Only needed if something else
# in your environment already occupies PORT/4000 — leave unset otherwise.
# API_PORT=4000
