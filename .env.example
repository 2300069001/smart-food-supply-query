# Base URL of the backend API. Vite loads this automatically (no extra
# tooling needed) and exposes it as import.meta.env.VITE_API_URL.
#
# Local development (default if this file isn't copied to .env):
VITE_API_URL=http://localhost:4000

# Production example — point this at your deployed backend:
# VITE_API_URL=https://your-backend.onrender.com
